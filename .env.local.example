# ── AI tutor LLM (optional) ─────────────────────────────────────────────────
# The tutor works with any OpenAI-compatible chat API, or with Anthropic.
# Pick a provider and fill in the four vars below, then restart `npm run dev`.

# "openai" (default; any OpenAI-compatible /chat/completions) or "anthropic".
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o                 # model for reviews / error explanations
LLM_MODEL_LIGHT=gpt-4o-mini      # optional: cheaper model for one-off hints

# Anthropic example — set LLM_PROVIDER=anthropic and use these instead:
#   LLM_BASE_URL=https://api.anthropic.com/v1
#   LLM_API_KEY=sk-ant-...
#   LLM_MODEL=claude-opus-4-8
#   LLM_MODEL_LIGHT=claude-haiku-4-5
